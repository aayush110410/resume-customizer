# LLM providers, tried in LLM_PROVIDER_ORDER. A provider without a key is skipped
# (except a local Ollama at http://localhost:11434/v1, which needs none).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_ANALYSIS_MODELS=gpt-oss:120b,nemotron-3-super
OLLAMA_WRITER_MODELS=gpt-oss:120b,nemotron-3-super

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
OPENROUTER_WRITER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

# Free key from Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_ANALYSIS_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_WRITER_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ANALYSIS_MODELS=openai/gpt-oss-120b
GROQ_WRITER_MODELS=openai/gpt-oss-120b

LLM_PROVIDER_ORDER=ollama,gemini,groq,openrouter
LLM_TIMEOUT_S=90

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5
MAX_PAGES=5
JD_MIN_CHARS=300
JD_MAX_CHARS=20000
RATE_LIMIT=20/hour
