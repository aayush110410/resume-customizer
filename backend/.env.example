# LLM providers, tried in LLM_PROVIDER_ORDER. A provider without a key is skipped
# (except a local Ollama at http://localhost:11434/v1, which needs none).
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_ANALYSIS_MODELS=gpt-oss:120b,gpt-oss:20b
OLLAMA_WRITER_MODELS=gpt-oss:120b,gpt-oss:20b

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
OPENROUTER_WRITER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ANALYSIS_MODELS=openai/gpt-oss-120b
GROQ_WRITER_MODELS=openai/gpt-oss-120b

LLM_PROVIDER_ORDER=ollama,openrouter,groq
LLM_TIMEOUT_S=90

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5
MAX_PAGES=5
JD_MIN_CHARS=300
JD_MAX_CHARS=20000
RATE_LIMIT=20/hour
